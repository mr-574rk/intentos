# Backend environment variables
# Copy to .env before running

PORT=4000
NODE_ENV=development

# Execution mode: mock (demo-safe) | testnet (real Initia)
EXECUTION_MODE=mock

# Initia network
INITIA_RPC=https://rpc.testnet.initia.xyz
INITIA_REST=https://lcd.testnet.initia.xyz
CHAIN_ID=initiation-2

# Contract addresses (update after deployment)
CONTRACT_STRATEGY_EXECUTOR=init1strategy_executor_placeholder
CONTRACT_PERMISSION_MANAGER=init1permission_manager_placeholder

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Optional: OpenAI API key for LLM-powered intent parsing (Phase 2)
# OPENAI_API_KEY=sk-...
